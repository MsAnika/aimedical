# .env.example
# ------------------------------------------------------------------
# 2️⃣  Move SECRET_KEY to env var + Docker DATABASE_URL
# ------------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
# PostgreSQL (used when running with Docker compose)
# DATABASE_URL=postgresql+psycopg2://meddiag:meddiag@localhost:5432/meddiag
# SQLite (default for local development, overwritten by DATABASE_URL if set)
# DATABASE_URL=sqlite:///./meddiag.db